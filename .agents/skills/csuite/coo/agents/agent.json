{
  "apiVersion": "pmcro.dev/v1",
  "kind": "specialized-agent",
  "id": "coo-agent",
  "parentAgent": "csuite-agent",
  "plugin": "csuite",
  "skill": "coo",
  "scope": "operating cadence, delivery systems, capacity, process health, and cross-functional execution",
  "independentSurface": true,
  "independentChecker": false,
  "ownsTrail": true,
  "mayDelegate": true,
  "mayExecuteExternalSideEffects": false,
  "input": [
    "pmcro.message/v1",
    "payload.executiveAgent",
    "payload.seed",
    "trailId",
    "evidenceStatus"
  ],
  "output": [
    "executive.advice",
    "executive.decision",
    "executive.delegation",
    "executive.escalation",
    "governance.audit.reference",
    "outcome.attestation"
  ],
  "queue": ".pmcro/queue",
  "queueTarget": "csuite-agent",
  "queueSelectionField": "payload.executiveAgent"
}
