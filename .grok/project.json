{
  "schema": "pmcro.agent-project/v1",
  "id": "csuite-agent",
  "description": "C-suite domain orchestrator with bounded executive child agents and cross-domain delegation.",
  "derivedFrom": "agent-skills-template",
  "template": "agent-skills-template",
  "canonical": ".pmcro",
  "projection": ".agents",
  "hostChain": ".claude/.grok/.cursor/.github -> .agents -> .pmcro",
  "requiredSkillShape": [
    "SKILL.md",
    "agents/",
    "scripts/",
    "references/",
    "assets/",
    "tests/"
  ],
  "autonomousLoop": {
    "enabled": true,
    "questionGate": false,
    "onQuestion": "resolve-from-context-or-halt",
    "phaseOrder": [
      "orchestrate",
      "plan",
      "make",
      "check",
      "reflect"
    ]
  },
  "orchestratorRole": "domain-meta-orchestrator",
  "agentIsOrchestrator": true
}
